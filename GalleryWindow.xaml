<Window x:Class="Prtsc.GalleryWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Prtsc — ギャラリー" Width="780" Height="590" MinWidth="540" MinHeight="380" WindowStartupLocation="CenterScreen" Background="#F5F6FA" FontFamily="Yu Gothic UI, Segoe UI" FontSize="13">
  <Grid Margin="24">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid Margin="0,0,0,20"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel><TextBlock Text="キャプチャ・ギャラリー" FontSize="23" FontWeight="SemiBold" Foreground="#20263B"/><TextBlock Text="コピーしてすぐ共有。編集データはそのまま。" Foreground="#8590A6" Margin="0,6,0,0"/></StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button Content="設定" Click="SettingsClick"/><Button Content="＋ 撮影" Click="CaptureClick" Background="#6366F1" Foreground="White" BorderThickness="0"/></StackPanel>
    </Grid>
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <ItemsControl x:Name="Cards">
        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate><DataTemplate>
          <Border Width="222" Margin="0,0,12,14" Background="White" CornerRadius="10" BorderBrush="#E2E8F0" BorderThickness="1" Padding="10">
            <StackPanel>
              <Button Tag="{Binding}" Click="EditClick" Padding="0" Margin="0" BorderThickness="0" Background="#EEF0F6" ToolTip="クリックで編集 · ドラッグでPNGファイルとして共有">
                <Image Source="{Binding Thumbnail}" Width="200" Height="126" Stretch="Uniform"/>
              </Button>
              <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" FontWeight="SemiBold" Foreground="#334155" Margin="2,10,0,0"/>
              <TextBlock Text="{Binding Caption}" Foreground="#8590A6" FontSize="11" Margin="2,4,0,8"/>
              <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                <Button Tag="{Binding}" Content="コピー" Click="CopyClick" Padding="10,7" ToolTip="注釈を含む画像としてコピー"/>
                <Button Grid.Column="1" Tag="{Binding}" Content="編集" Click="EditClick" Padding="10,7"/>
              </Grid>
            </StackPanel>
          </Border>
        </DataTemplate></ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
    <TextBlock x:Name="GalleryStatus" Grid.Row="2" Text="撮影した画像がここに並びます。" Foreground="#8590A6" Margin="0,12,0,0"/>
  </Grid>
</Window>
