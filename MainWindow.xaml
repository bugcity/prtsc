<Window x:Class="Prtsc.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Prtsc — Capture studio" Icon="Assets/Prtsc.ico" Width="1280" Height="840" MinWidth="1000" MinHeight="680" Background="#F5F6FA" FontFamily="Yu Gothic UI, Segoe UI" FontSize="13" WindowStartupLocation="CenterScreen" AllowDrop="True" Drop="OnDrop">
  <Grid Background="#F5F6FA">
    <Grid.ColumnDefinitions><ColumnDefinition Width="264"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Background="#171C2E">
      <Grid Margin="18,25,18,18">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Margin="9,0,0,26"><TextBlock Text="▣  prtsc" Foreground="White" FontSize="29" FontWeight="Bold"/><TextBlock Text="CAPTURE STUDIO" Foreground="#8A93B3" FontSize="10" Margin="1,6,0,0"/></StackPanel>
        <StackPanel Grid.Row="1">
          <Button Content="＋  範囲をキャプチャ" Background="#7375FA" Foreground="White" BorderThickness="0" Padding="16,14" FontWeight="SemiBold" Click="CaptureRegion"/>
          <Button Content="▣  ウィンドウを選択して撮影" Background="#282F46" Foreground="#D8DEF1" BorderThickness="0" Click="CaptureWindow" Margin="3,7,3,0"/>
          <Button Content="●  動画を録画" Background="#282F46" Foreground="#D8DEF1" BorderThickness="0" Click="StartVideoRecording" Margin="3,7,3,0"/>
          <Grid Margin="0,5,0,20"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Button Content="画面全体" Background="#282F46" Foreground="#D8DEF1" BorderThickness="0" Click="CaptureFull"/><Button Grid.Column="1" Content="画像を開く" Background="#282F46" Foreground="#D8DEF1" BorderThickness="0" Click="OpenImage"/></Grid>
        </StackPanel>
        <Grid Grid.Row="2" Margin="8,0,8,12"><TextBlock Text="ライブラリ" Foreground="#A5AEC9" FontWeight="SemiBold"/><TextBlock x:Name="CountLabel" Text="0 枚" Foreground="#8A93B3" HorizontalAlignment="Right"/></Grid>
        <ListBox x:Name="History" Grid.Row="3" Background="Transparent" BorderThickness="0" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" ScrollViewer.CanContentScroll="True" ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionChanged="HistoryChanged">
          <ListBox.Resources>
            <Style TargetType="ScrollBar">
              <Setter Property="Width" Value="12"/>
              <Setter Property="Margin" Value="4,0,0,0"/>
              <Setter Property="Background" Value="Transparent"/>
              <Setter Property="Stylus.IsFlicksEnabled" Value="False"/>
              <Setter Property="Template">
                <Setter.Value>
                  <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
                      <Track x:Name="PART_Track" Orientation="Vertical" IsDirectionReversed="True"
                             Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" ViewportSize="{TemplateBinding ViewportSize}"
                             Value="{Binding Value, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                        <Track.DecreaseRepeatButton>
                          <RepeatButton Command="ScrollBar.PageUpCommand" Focusable="False" IsTabStop="False">
                            <RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></RepeatButton.Template>
                          </RepeatButton>
                        </Track.DecreaseRepeatButton>
                        <Track.Thumb>
                          <Thumb MinHeight="28" Cursor="Hand">
                            <Thumb.Template>
                              <ControlTemplate TargetType="Thumb">
                                <Border x:Name="Grip" Background="#505B7A" Width="6" HorizontalAlignment="Center" CornerRadius="3"/>
                                <ControlTemplate.Triggers>
                                  <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ScrollBar}}" Value="True">
                                    <Setter TargetName="Grip" Property="Background" Value="#818BAD"/>
                                    <Setter TargetName="Grip" Property="Width" Value="8"/>
                                  </DataTrigger>
                                  <Trigger Property="IsDragging" Value="True"><Setter TargetName="Grip" Property="Background" Value="#A5A7FF"/></Trigger>
                                </ControlTemplate.Triggers>
                              </ControlTemplate>
                            </Thumb.Template>
                          </Thumb>
                        </Track.Thumb>
                        <Track.IncreaseRepeatButton>
                          <RepeatButton Command="ScrollBar.PageDownCommand" Focusable="False" IsTabStop="False">
                            <RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></RepeatButton.Template>
                          </RepeatButton>
                        </Track.IncreaseRepeatButton>
                      </Track>
                    </Grid>
                    <ControlTemplate.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.35"/></Trigger></ControlTemplate.Triggers>
                  </ControlTemplate>
                </Setter.Value>
              </Setter>
            </Style>
          </ListBox.Resources>
          <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,0,0,10"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="Card" CornerRadius="9" BorderThickness="2" BorderBrush="Transparent" Background="#232A40" Padding="9"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="Card" Property="BorderBrush" Value="#9294FF"/><Setter TargetName="Card" Property="Background" Value="#303653"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle>
          <ListBox.ItemTemplate><DataTemplate><StackPanel><Border Height="104" Background="#111626" CornerRadius="4" ClipToBounds="True"><Image Source="{Binding Thumbnail}" Stretch="Uniform"/></Border><TextBlock Text="{Binding Title}" Foreground="#F0F2FC" TextTrimming="CharacterEllipsis" Margin="2,9,0,0"/><TextBlock Text="{Binding Caption}" Foreground="#98A2BF" FontSize="11" Margin="2,4,0,0"/></StackPanel></DataTemplate></ListBox.ItemTemplate>
        </ListBox>
        <StackPanel Grid.Row="4" Margin="8,17,0,0"><Button Content="⚙ ライブラリの設定" Click="OpenSettings" Background="#282F46" Foreground="#D8DEF1" BorderThickness="0" Margin="0,0,8,12"/><TextBlock x:Name="HotkeyLabel" Text="PrtSc  範囲 / ウィンドウ撮影" Foreground="#A5AEC9" FontSize="11"/><TextBlock Text="画像をドラッグしてファイルとして共有" Foreground="#67728F" FontSize="10" Margin="0,5,0,0"/></StackPanel>
      </Grid>
    </Border>
    <Grid Grid.Column="1">
      <Grid.RowDefinitions><RowDefinition Height="64"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="43"/></Grid.RowDefinitions>
      <Border Background="White" BorderBrush="#E5E8F0" BorderThickness="0,0,0,1">
        <Grid Margin="25,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <StackPanel VerticalAlignment="Center"><TextBlock x:Name="TitleLabel" Text="キャプチャを、伝わる一枚に。" FontWeight="SemiBold" FontSize="19" Foreground="#20263B" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="DetailLabel" Text="撮影して、書き込んで、すぐ共有。" Foreground="#8590A6" Margin="0,5,0,0"/></StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button Content="コピー" ToolTip="Ctrl+C · 画像または動画ファイルをコピー" Click="CopyImage"/><Button x:Name="ExportButton" Content="PNG を保存 ↗" Background="#6366F1" Foreground="White" BorderThickness="0" Click="ExportImage"/></StackPanel>
        </Grid>
      </Border>
      <Border x:Name="EditorToolbar" Grid.Row="1" Background="White" BorderBrush="#E5E8F0" BorderThickness="0,0,0,1" Padding="12,5">
        <StackPanel>
          <WrapPanel x:Name="Tools">
            <Button Tag="Select" Content="↖ 選択" Click="ChooseTool" ToolTip="V · 注釈の選択・移動・サイズ変更"/>
            <Button Tag="Arrow" Content="↗  矢印" Click="ChooseTool" ToolTip="A"/>
            <Button Tag="Rectangle" Content="▢  四角" Click="ChooseTool" ToolTip="R"/>
            <Button Tag="Ellipse" Content="○  丸" Click="ChooseTool" ToolTip="E"/>
            <Button Tag="Pen" Content="✎  ペン" Click="ChooseTool" ToolTip="P"/>
            <Button Tag="Highlight" Content="▰  蛍光ペン" Click="ChooseTool" ToolTip="H"/>
            <Button Tag="Text" Content="T  テキスト" Click="ChooseTool" ToolTip="T"/>
            <Button Tag="Number" Content="❶  番号" Click="ChooseTool" ToolTip="N"/>
            <Button Tag="Crop" Content="✂ トリム" Click="ChooseTool" ToolTip="C · 範囲を指定して切り抜き"/>
            <Button Content="↶" Click="Undo" ToolTip="Ctrl+Z · 元に戻す" Padding="10,3" VerticalAlignment="Center"/><Button Content="↷" Click="Redo" ToolTip="Ctrl+Y · やり直す" Padding="10,3" VerticalAlignment="Center"/>
            <Button x:Name="DeleteCaptureButton" Content="画像を削除" Click="DeleteCapture" ToolTip="現在のキャプチャを削除" Padding="10,3" VerticalAlignment="Center"/>
          </WrapPanel>
          <WrapPanel x:Name="AnnotationProperties" Margin="3,2,0,0" VerticalAlignment="Center">
            <TextBlock Text="色" Margin="0,0,8,0" Foreground="#8590A6"/>
            <Button Tag="#F43F5E" Background="#F43F5E" Width="25" Height="25" Padding="0" Click="ChooseColor" ToolTip="ローズ"/>
            <Button Tag="#6366F1" Background="#6366F1" Width="25" Height="25" Padding="0" Click="ChooseColor" ToolTip="インディゴ"/>
            <Button Tag="#0EA5E9" Background="#0EA5E9" Width="25" Height="25" Padding="0" Click="ChooseColor" ToolTip="ブルー"/>
            <Button Tag="#10B981" Background="#10B981" Width="25" Height="25" Padding="0" Click="ChooseColor" ToolTip="グリーン"/>
            <Button Tag="#F59E0B" Background="#F59E0B" Width="25" Height="25" Padding="0" Click="ChooseColor" ToolTip="アンバー"/>
            <Button Tag="#1E293B" Background="#1E293B" Width="25" Height="25" Padding="0" Click="ChooseColor" ToolTip="ダーク"/>
            <TextBlock Text="太さ" Margin="18,0,5,0" Foreground="#8590A6"/>
            <Slider x:Name="StrokeSlider" Width="75" Minimum="2" Maximum="12" Value="4" VerticalAlignment="Center" IsSnapToTickEnabled="True" TickFrequency="1" ValueChanged="StrokeChanged"/>
            <Rectangle x:Name="CurrentColor" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" Width="4" Height="22" Fill="#F43F5E" Margin="12,0,10,0"/>
            <TextBlock Text="矢印" Foreground="#8590A6" Margin="5,0,8,0"/>
            <ComboBox x:Name="ArrowStyleBox" Width="215" SelectedValuePath="Key" SelectionChanged="ArrowStyleChanged" VerticalContentAlignment="Center" ToolTip="矢印スタイル · 新規または選択中の矢印に適用" Margin="0,0,8,0">
              <ComboBox.ItemTemplate><DataTemplate><StackPanel Orientation="Horizontal"><Image Source="{Binding Preview}" Width="76" Height="27" Margin="0,0,12,0"/><TextBlock Text="{Binding Name}"/></StackPanel></DataTemplate></ComboBox.ItemTemplate>
            </ComboBox>
            <Button x:Name="EditTextButton" Content="文字を編集" Click="EditSelectedText" IsEnabled="False" Padding="10,3"/>
            <Button x:Name="DeleteMarkButton" Content="注釈を削除" Click="DeleteSelected" IsEnabled="False" Padding="10,3"/>
            <Button Content="編集操作 ▾" Padding="10,3" Click="OpenEditMenu" ToolTip="複製・複数選択・重なり順">
              <Button.ContextMenu><ContextMenu>
                <MenuItem Header="文字の書式…" Click="EditTextStyle"/>
                <Separator/>
                <MenuItem Header="複製" InputGestureText="Ctrl+D" Click="DuplicateSelected"/>
                <MenuItem Header="すべての注釈を選択" InputGestureText="Ctrl+A" Click="SelectAllClick"/>
                <MenuItem Header="前面へ" InputGestureText="Ctrl+PageUp" Click="BringForward"/>
                <MenuItem Header="背面へ" InputGestureText="Ctrl+PageDown" Click="SendBackward"/>
                <MenuItem Header="最前面へ" InputGestureText="Ctrl+Home" Click="BringToFront"/>
                <MenuItem Header="最背面へ" InputGestureText="Ctrl+End" Click="SendToBack"/>
              </ContextMenu></Button.ContextMenu>
            </Button>
          </WrapPanel>
        </StackPanel>
      </Border>
      <Grid x:Name="EditorViewport" Grid.Row="2" Margin="12" SizeChanged="ViewportChanged">
        <Grid x:Name="VideoPreview" Visibility="Collapsed" Background="#111626">
          <Image x:Name="VideoThumbnail" Stretch="Uniform" Opacity="0.65"/>
          <Button Content="▶ 動画を再生" Click="PlaySelectedVideo" HorizontalAlignment="Center" VerticalAlignment="Center" Background="White" Padding="24,14"/>
        </Grid>
        <Border x:Name="EmptyState" Background="White" CornerRadius="16" BorderBrush="#E2E8F0" BorderThickness="1">
          <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <Border Background="#EEF0FF" CornerRadius="20" Width="84" Height="84" HorizontalAlignment="Center"><TextBlock Text="▣" FontSize="44" Foreground="#6366F1" HorizontalAlignment="Center"/></Border>
            <TextBlock Text="ひらめきを、キャプチャ。" FontSize="24" FontWeight="SemiBold" Foreground="#27314A" HorizontalAlignment="Center" Margin="0,25,0,12"/>
            <TextBlock Text="範囲を撮影するか、画像をここにドロップ。" Foreground="#8590A6" HorizontalAlignment="Center"/>
            <Button Content="最初のキャプチャを撮る  ↗" Click="CaptureRegion" Background="#6366F1" Foreground="White" BorderThickness="0" HorizontalAlignment="Center" Margin="0,26,0,0" Padding="24,14"/>
            <TextBlock Text="画像の貼り付けにも対応 · Ctrl + V" Foreground="#A1AABC" FontSize="11" HorizontalAlignment="Center" Margin="0,18,0,0"/>
          </StackPanel>
        </Border>
        <ScrollViewer x:Name="ImageView" Visibility="Collapsed" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" CanContentScroll="False" PreviewMouseWheel="ZoomWheel">
          <Border Padding="16"><Canvas x:Name="Editor" Background="White" ClipToBounds="True" Cursor="Cross" MouseLeftButtonDown="BeginDraw" MouseMove="MoveDraw" MouseLeftButtonUp="EndDraw" LostMouseCapture="LostCapture">
            <Canvas.LayoutTransform><ScaleTransform x:Name="EditorScale" ScaleX="1" ScaleY="1"/></Canvas.LayoutTransform>
          </Canvas></Border>
        </ScrollViewer>
        <Border x:Name="CropActions" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Top" Background="White" CornerRadius="8" BorderBrush="#CBD5E1" BorderThickness="1" Padding="7" Margin="0,6,0,0">
          <StackPanel Orientation="Horizontal"><TextBlock Text="範囲をドラッグ" Margin="8,0,10,0" Foreground="#64748B"/><Button x:Name="ApplyCropButton" Content="適用" Click="ApplyCropClick" Background="#6366F1" Foreground="White" IsEnabled="False"/><Button Content="キャンセル" Click="CancelCropClick"/></StackPanel>
        </Border>
      </Grid>
      <Border Grid.Row="3" Background="White" BorderBrush="#E5E8F0" BorderThickness="0,1,0,0"><Grid Margin="15,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel VerticalAlignment="Center"><TextBlock x:Name="StatusLabel" Text="準備完了" Foreground="#8590A6" FontSize="11" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="SelectionLabel" Text="V で選択 · ダブルクリックで文字を編集" Foreground="#8590A6" FontSize="11" TextTrimming="CharacterEllipsis"/></StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button Content="−" Click="ZoomOut" Padding="10,3" Height="30" ToolTip="縮小 · Ctrl+マウスホイール"/><TextBlock x:Name="ZoomLabel" Text="100%" Width="52" TextAlignment="Center" Foreground="#64748B"/><Button Content="＋" Click="ZoomIn" Padding="10,3" Height="30" ToolTip="拡大 · Ctrl+マウスホイール"/><Button Content="100%" Click="ZoomActual" Padding="10,3" Height="30" ToolTip="原寸で表示"/><Button Content="全体" Click="ZoomFit" Padding="10,3" Height="30" ToolTip="画像全体を表示"/></StackPanel>
      </Grid></Border>
    </Grid>
  </Grid>
</Window>
