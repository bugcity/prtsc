<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\Prtsc.ico</ApplicationIcon>
    <AssemblyName>Prtsc</AssemblyName>
    <RootNamespace>Prtsc</RootNamespace>
    <PlatformTarget>x64</PlatformTarget>
    <Platform>x64</Platform>
    <Platforms>x64</Platforms>
    <OutputPath>bin\$(Configuration)\</OutputPath>
  </PropertyGroup>
  <ItemGroup><Resource Include="Assets\Prtsc.ico"/></ItemGroup>
  <ItemGroup><PackageReference Include="ScreenRecorderLib" Version="7.0.1"/></ItemGroup>
  <ItemGroup><None Update="THIRD_PARTY_NOTICES.md" CopyToOutputDirectory="PreserveNewest"/></ItemGroup>
</Project>
